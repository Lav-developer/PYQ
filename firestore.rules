rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // helper: true if the signed-in user's email matches the admin email
    // TODO: replace with your real admin email and consider using custom claims/role field instead
    function isAdminByEmail() {
      return request.auth != null
             && request.auth.token.email == "abc@gmail.com";
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Contribution points are mapped by EMAIL (uploaders do not need an
    // account), so every email is compared in its normalized form:
    // trim + lowercase. This must stay identical to points.js.
    function normalizedEmail(value) {
      return value.trim().lower();
    }

    // True when the signed-in user owns the reward data described by `data`
    // (a reward_accounts doc or a point_transactions doc).
    function ownsRewardEmail(data) {
      return isSignedIn()
             && request.auth.token.email is string
             && 'email' in data
             && data.email is string
             && data.email == normalizedEmail(request.auth.token.email);
    }

    // A public (no sign-in) contribution: a PENDING submission only. The
    // client can never set a review state, a reward flag or a points field.
    function isValidPendingSubmission() {
      return request.resource.data.title is string
             && request.resource.data.title.size() > 2
             && request.resource.data.title.size() <= 200
             && request.resource.data.studentName is string
             && request.resource.data.studentName.size() >= 2
             && request.resource.data.studentName.size() <= 80
             && request.resource.data.status == 'pending'
             && request.resource.data.studentEmail is string
             && request.resource.data.studentEmail.size() <= 160
             && request.resource.data.studentEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$')
             && request.resource.data.downloadUrl is string
             && request.resource.data.downloadUrl.size() > 10
             && request.resource.data.downloadUrl.size() <= 500
             && request.resource.data.downloadUrl.matches('https://[a-z0-9.-]+\\.gofile\\.io/.+')
             && request.resource.data.fileName is string
             && request.resource.data.fileName.size() <= 200
             // Review state + points are written by the admin panel only.
             && !('pointsAwarded' in request.resource.data)
             && !('pointsTransactionId' in request.resource.data)
             && !('pointsAmount' in request.resource.data)
             && !('reviewedAt' in request.resource.data)
             && !('reviewedBy' in request.resource.data)
             && !('rejectionReason' in request.resource.data);
    }

    // ─────────────────────────────────────────
    // PYQs — NO direct public reads (all public data flows through the
    // Cloudflare Worker API, which authenticates with a service account that
    // bypasses these rules). Admin can read/write; verified users can still
    // +1 views directly from the browser.
    // ─────────────────────────────────────────
    match /pyqs/{doc} {
      allow read: if isAdminByEmail();
      allow create, delete: if isAdminByEmail();
      // Admin can do any update; verified users (email verified) can only increment `views` by 1
      allow update: if isAdminByEmail() || (isVerified() && (
        // first-time view: doc had no views field, new views == 1
        ( !('views' in resource.data) && request.resource.data.views == 1 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) )
        ||
        // normal increment: only `views` changed and +1
        ( 'views' in resource.data
          && request.resource.data.views is number
          && resource.data.views is number
          && request.resource.data.views == resource.data.views + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) )
      ));
    }

    // Contributors — likewise served by the Worker API; admin-only direct reads
    match /contributors/{doc}{
      allow read: if isAdminByEmail();
      allow create, update, delete: if isAdminByEmail();
    }

    match /syllabus/{doc} {
      allow read: if true;
      allow write: if isAdminByEmail();
    }

    // ─────────────────────────────────────────
    // Users — owners manage own doc
    // ─────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdminByEmail());
      allow create: if isSignedIn()
                    && isOwner(userId)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email == request.auth.token.email;
      allow update: if isSignedIn()
                    && (isOwner(userId) || isAdminByEmail());
      allow delete: if isSignedIn()
                    && (isOwner(userId) || isAdminByEmail());
    }

    // pendingUploads (PYQ submissions / review queue) — only the admin can
    // read, update or delete. Anyone (no sign-in required) may create a valid
    // PENDING submission; the status can never be anything but pending and no
    // points/review field can be written by a client.
    match /pendingUploads/{doc} {
      allow read: if isAdminByEmail();
      allow create: if isValidPendingSubmission();
      allow update, delete: if isAdminByEmail();
    }

    // ─────────────────────────────────────────
    // NEW: PYQ Contribution Points — email-based reward accounts + ledger.
    // Balances are ONLY ever written by the admin panel (admin.js) inside a
    // Firestore transaction; a signed-in student may read their own account
    // and link it to their own uid, and nothing more.
    // ─────────────────────────────────────────
    match /reward_accounts/{accountKey} {
      allow read: if isAdminByEmail() || ownsRewardEmail(resource.data);
      allow create, delete: if isAdminByEmail();
      allow update: if isAdminByEmail()
                    || (ownsRewardEmail(resource.data)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
                        && request.resource.data.uid == request.auth.uid);
    }

    // One document per rewarded submission (doc id = submission id), which is
    // what makes double-rewarding a submission impossible.
    match /point_transactions/{transactionId} {
      allow read: if isAdminByEmail() || ownsRewardEmail(resource.data);
      allow create, update, delete: if isAdminByEmail();
    }

    // ─────────────────────────────────────────
    // NEW: Paper Detail Page — Comments
    // Top-level `comments` (paper.js tries this first)
    // ─────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isVerified()
                    && request.resource.data.paperId is string
                    && request.resource.data.paperId.size() > 0
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 3
                    && request.resource.data.text.size() <= 600
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.userName is string;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdminByEmail());
    }

    // Fallback subcollection `pyqs/{pyqId}/comments/{commentId}` (paper.js fallback)
    match /pyqs/{pyqId}/comments/{commentId} {
      allow read: if true;
      allow create: if isVerified()
                    && request.resource.data.paperId is string
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 3
                    && request.resource.data.text.size() <= 600
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdminByEmail());
    }

    // ─────────────────────────────────────────
    // NEW: Feedback / Reports (Report Broken Link + Request PYQ)
    // paper.html + script.js write to `feedback`
    // NOTE: allow anon create with validation; tighten later with rate limiting
    // ─────────────────────────────────────────
    match /feedback/{doc} {
      allow read: if isAdminByEmail();
      allow create: if isVerified()
                    && request.resource.data.type is string
                    && request.resource.data.type in ['broken_link', 'pyq_request']
                    && request.resource.data.status == 'new';
      allow update, delete: if isAdminByEmail();
    }

    // Optional aggregated stats for homepage (public read)
    match /meta/{doc} {
      allow read: if true;
      allow write: if isAdminByEmail();
    }

    // Lock everything else
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
