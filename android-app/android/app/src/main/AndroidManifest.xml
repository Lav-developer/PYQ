<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Site deep links (unverified https links — Android offers the app
              in a chooser; the website keeps working exactly as before).
              Tapping e.g. https://dsmnru-pyq.netlify.app/pyq/<slug> can open
              the PAPER SCREEN natively — MainActivity forwards the URL to the
              app's JS router. Verified Android App Links would require
              publishing /.well-known/assetlinks.json with the release signing
              fingerprint, deliberately deferred until a release keystore flow
              exists.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="dsmnru-pyq.netlify.app" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="dsmnru-pyq.email" />
            </intent-filter>

        </activity>

        <!--
          In-app PDF viewer screen (opened by the DsmnruApp.pdfView plugin
          method). Sits on top of MainActivity, so system Back returns to the
          paper detail screen. Never exported — it is launched by the app only.
        -->
        <activity
            android:name=".PdfViewerActivity"
            android:exported="false"
            android:label="PDF viewer"
            android:theme="@style/AppTheme.NoActionBar"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density" />

    <!--
      FCM receiver (the ONLY push component). Foreground messages are
      rendered by FcmService itself on the app channel; background
      notification payloads are auto-displayed by the system tray using the
      default channel/icon/color meta-data below, and the tray tap opens the
      MainActivity deep-link intent. No polling, no listeners, no token
      database: the global audience is the single FCM topic `all_users`
      (version-gated subscribe — one FCM call per install/update).
    -->
    <service
        android:name=".FcmService"
        android:exported="false">
        <intent-filter>
            <action android:name="com.google.firebase.MESSAGING_EVENT" />
        </intent-filter>
    </service>

    <!-- Brand the system tray for background notification payloads. -->
    <meta-data
        android:name="com.google.firebase.messaging.default_notification_channel_id"
        android:value="dsmnru_general" />
    <meta-data
        android:name="com.google.firebase.messaging.default_notification_icon"
        android:resource="@drawable/ic_stat_dsmnru" />
    <meta-data
        android:name="com.google.firebase.messaging.default_notification_color"
        android:resource="@color/dsmnru_teal" />

    </application>

    <!-- Permissions -->
    <!-- The dedicated app UI is bundled in the APK; its only data path is the
         existing Cloudflare Worker API (HTTPS), so INTERNET is the only data
         permission. DownloadManager needs no permission, and no storage
         permission is requested or needed.
         POST_NOTIFICATIONS (Android 13+): the REAL system runtime dialog —
         requested once per install, a few seconds into the first session,
         only when a Firebase-enabled build is running. Denying changes
         nothing except that push stays silent; the decision is never
         re-asked on later launches. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
