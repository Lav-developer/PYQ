<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme (used by anything that is not the bridge
         activity; the bridge itself uses AppTheme.NoActionBar below). -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/dsmnru_dark</item>
        <item name="colorPrimaryDark">@color/dsmnru_dark</item>
        <item name="colorAccent">@color/dsmnru_teal</item>
    </style>

    <!--
      Runtime theme of the app UI.
      * DayNight parent while the app itself ships a single dark brand theme
        (the app's CSS declares color-scheme: dark and paints its own dark
        surface, so the window background is the only piece that must match).
      * The dark window background (#0F172A, the brand slate) prevents any
        white flash between the splash and the bundled app shell.
      * statusBarColor/navigationBarColor apply to Android < 15; on Android
        15+ edge-to-edge is enforced by the platform, and the app pads its
        layout with safe-area insets from CSS (viewport-fit=cover, plus the
        Capacitor SystemBars 'css' inset mode) so content never sits under
        the bars. Light (white) status/nav icons suit the dark brand color.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/dsmnru_dark</item>
        <item name="android:statusBarColor">@color/dsmnru_dark</item>
        <item name="android:navigationBarColor">@color/dsmnru_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!--
      Launch/splash theme, driven by androidx.core:core-splashscreen.
      The @capacitor/splash-screen plugin calls installSplashScreen() and keeps
      the branded splash for a short hand-off window (launchShowDuration in
      capacitor.config.json) with a quick fade — the bundled app shell paints
      instantly from APK assets, so this is mostly the Android system window.

      windowSplashScreenBackground/AnimatedIcon are the modern Android 12+
      splash attributes (the compat library emulates them on older devices),
      android:background is the legacy window background used before
      installSplashScreen() runs, and postSplashScreenTheme is required by the
      compat library to switch to the runtime theme.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">250</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
