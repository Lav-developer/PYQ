{
  "appId": "com.dsmnru.pyq",
  "appName": "DSMNRU PYQ",
  "webDir": "www",
  "backgroundColor": "#0F172A",
  "Zooming": false,
  "loggingBehavior": "production",
  "appendUserAgent": "DSMNRU-PYQ-Android/2-native",
  "android": {
    "backgroundColor": "#0F172A",
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "launchFadeInDuration": 0,
      "launchFadeOutDuration": 220,
      "backgroundColor": "#0F172A",
      "androidSplashResourceName": "splash",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": false
    },
    "SystemBars": {
      "style": "DARK",
      "insetsHandling": "css",
      "hidden": false
    }
  }
}
